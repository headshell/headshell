# Maintainer: enaimami <1terabyterma@gmail.com>
#
# The prebuilt form of the `headshell` desktop app. The package that builds from
# source is `packaging/aur/headshell/`; the prebuilt CLI is `headshell-cli-bin/`.
#
# Why a binary package: the source package compiles the Tauri shell and ~500 crates.
# That is the right job to do, but its price is measured in minutes.
#
# Why it is **not in the same PKGBUILD** as the CLI: a split package exists because
# of a shared build — like the source package getting two binaries out of a single
# `cargo build`. There is no build here; the two packages share no work. Had they
# been split, a user installing only the CLI would download the 10 MB `.deb` too,
# and namcap rightly gave a `splitpkgmakedeps` error.
#
# The binary comes out of the `.deb`; the `.AppImage` is not used — it is 85 MB and
# carries its own libraries, and an Arch package should link against the system's.
#
# The `.desktop`, the icons and the license files are taken **from the source
# archive** (1.2 MB). The reason: installing files bit-for-bit identical to the
# source package's. With a second, hand-written desktop entry the two would drift
# apart over time.
#
# Compatibility: the binary is built on ubuntu-24.04, so it wants GLIBC_2.39. Arch
# always carries something newer; this direction is the safe one.

pkgname=headshell-bin
# The version on a single line — the same reasoning as in the sibling PKGBUILDs (D-063).
pkgver=0.0.1_beta
_pkgver=${pkgver//_/-}
pkgrel=1
pkgdesc='Provider-independent music listening layer (desktop app, prebuilt)'
arch=('x86_64')
url='https://github.com/headshell/headshell'
license=('MIT' 'Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'alsa-lib' 'hicolor-icon-theme')
optdepends=('headshell-cli-bin: command line interface'
            'gst-plugins-good: local music videos (D-086)'
            'gst-libav: local music videos in H.264 (D-086)')
provides=("headshell=$pkgver")
conflicts=('headshell')
# The binary comes from upstream; `makepkg` must not `strip` it again. Without
# `!debug` a meaningless `headshell-bin-debug` package is produced too — the symbols
# mean something where they were built, not here.
options=('!strip' '!debug')

_deb="headshell_${_pkgver}_amd64.deb"
_rel="$url/releases/download/v$_pkgver"
_srcdir="headshell-$_pkgver"

source=("headshell-$pkgver.tar.gz::$url/archive/refs/tags/v$_pkgver.tar.gz")
source_x86_64=("$_deb::$_rel/$_deb")
# A `.deb` is an `ar` archive; if makepkg extracted it we would be left with
# `data.tar.gz` and would have to extract that by hand anyway. `prepare()` does it in
# one step.
noextract=("$_deb")
# The checksums belong to the **current** `v0.0.1-beta` tag. If the tag moves
# (is cut again), the archive's checksum changes too — run `updpkgsums`, do not
# fix it by hand. The order is in `packaging/aur/README.md`.
sha256sums=('252d8c3d4ee72e93e4c8c525973a17a423ee9c004dadc52c88ca8f7339b519eb')
sha256sums_x86_64=('7087a1feb17ad4b19018be5a1b6635e2ac5f56b0cd3ce039e004c306fd8784e2')

prepare() {
  mkdir -p deb
  bsdtar -xOf "$_deb" data.tar.gz | bsdtar -xf - -C deb
}

package() {
  install -Dm755 "deb/usr/bin/headshell-desktop" "$pkgdir/usr/bin/headshell-desktop"

  # The `.deb`'s own `.desktop` entry is **not used**: Tauri generates it and its text
  # comes from `tauri.conf.json`. To install the same file as the source package, the
  # canonical entry from the repository is installed.
  install -Dm644 "$_srcdir/packaging/headshell.desktop" \
    "$pkgdir/usr/share/applications/headshell.desktop"

  # The icon name must be the same as `Icon=` in the `.desktop`.
  local _icons="$_srcdir/crates/headshell/icons"
  install -Dm644 "$_icons/32x32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/headshell-desktop.png"
  install -Dm644 "$_icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/headshell-desktop.png"
  install -Dm644 "$_icons/128x128@2x.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/headshell-desktop.png"
  install -Dm644 "$_icons/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/headshell-desktop.png"
  install -Dm644 "$_icons/icon.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/headshell-desktop.svg"

  install -Dm644 "$_srcdir/LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 "$_srcdir/LICENSE-APACHE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
