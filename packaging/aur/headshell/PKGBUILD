# Maintainer: enaimami <1terabyterma@gmail.com>
#
# Split package: two packages come out of a single build.
#
#   headshell      — the desktop app (Tauri + WebKitGTK)
#   headshell-cli  — the command line interface
#
# Both come from the same workspace and `build()` runs once. With separate
# PKGBUILDs, a user installing both would compile ~500 crates twice.
#
# `cargo tauri build` is **not used**: it is a bundler and produces `.deb`/`.AppImage`;
# we are building the Arch package here ourselves anyway. A plain `cargo build` drops
# `tauri-cli` as a build dependency; in return the `.desktop` entry and the icons are
# installed by hand.
#
# For those who do not want to pay for the build there are prebuilt packages:
# `headshell-bin` and `headshell-cli-bin` download the release assets. They are
# **not** split, because they share no build. The desktop entry is the same file in
# all of them: `packaging/headshell.desktop`.
#
# There is no runtime dependency for plugins: the engine (QuickJS) is inside the
# binary, and the engine downloads yt-dlp as a platform binary (D-069). The torrent
# plugin is parked (`parked/`) and does not go into the package.

pkgbase=headshell
pkgname=('headshell' 'headshell-cli')
# The version lives on a single line. In an Arch version `-` is the pkgrel separator,
# so `_` is written; the upstream spelling is derived from it (`0.0.1-beta`) and used
# both in the tag and in the extracted directory name. D-063 was the MSI side of the
# same mistake: if the version is written in two places, one drifts.
pkgver=0.0.1_beta
_pkgver=${pkgver//_/-}
pkgrel=1
pkgdesc='Provider-independent music listening layer — your history, stats and playlists stay yours'
arch=('x86_64')
url='https://github.com/headshell/headshell'
license=('MIT' 'Apache-2.0')
makedepends=('cargo' 'pkgconf' 'webkit2gtk-4.1' 'gtk3' 'alsa-lib')
source=("$pkgbase-$pkgver.tar.gz::$url/archive/refs/tags/v$_pkgver.tar.gz")
# The checksums belong to the **current** `v0.0.1-beta` tag. If the tag moves
# (is cut again), the archive's checksum changes too — run `updpkgsums`, do not
# fix it by hand. The order is in `packaging/aur/README.md`.
sha256sums=('252d8c3d4ee72e93e4c8c525973a17a423ee9c004dadc52c88ca8f7339b519eb')

_srcdir="$pkgbase-$_pkgver"

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  # `--locked`: whatever the Cargo.lock in the repository says. The tree the package
  # builds must be the same tree that passed the three gates upstream.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Two binaries, one build: `headshell-cli` → `headshell`,
  # `headshell` (the Tauri shell) → `headshell-desktop`.
  cargo build --frozen --release -p headshell-cli -p headshell
}

check() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The core tests. Tests that go online or want an audio device skip themselves
  # (D-043, D-059), so the package build does not depend on the build environment.
  #
  # A single-crate run is a diagnostic tool, not the three gates (CLAUDE.md): since
  # the features are not merged, `dead_code` warnings may appear. The gates run in
  # CI; the job of the run here is to see that the packaged tree really works on
  # the machine.
  cargo test --frozen --release -p headshell-core
}

package_headshell() {
  pkgdesc='Provider-independent music listening layer (desktop app)'
  depends=('webkit2gtk-4.1' 'gtk3' 'alsa-lib' 'hicolor-icon-theme')
  optdepends=('headshell-cli: command line interface'
              'gst-plugins-good: local music videos (D-086)'
              'gst-libav: local music videos in H.264 (D-086)')

  cd "$_srcdir"
  install -Dm755 "target/release/headshell-desktop" "$pkgdir/usr/bin/headshell-desktop"

  # The desktop entry comes from the repository, it is not written here. The
  # `StartupWMClass=headshell-desktop` in it was not made up: the entry Tauri
  # generates for the `.deb` was read, and the window class is derived from the binary
  # name. Had `headshell` been written, the running window would not match the
  # launcher icon.
  install -Dm644 packaging/headshell.desktop \
    "$pkgdir/usr/share/applications/headshell.desktop"

  # The icon name must be the same as `Icon=` in the `.desktop`.
  local _icons="crates/headshell/icons"
  install -Dm644 "$_icons/32x32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/headshell-desktop.png"
  install -Dm644 "$_icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/headshell-desktop.png"
  install -Dm644 "$_icons/128x128@2x.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/headshell-desktop.png"
  install -Dm644 "$_icons/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/headshell-desktop.png"
  install -Dm644 "$_icons/icon.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/headshell-desktop.svg"

  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}

package_headshell-cli() {
  pkgdesc='Provider-independent music listening layer (command line interface)'
  depends=('alsa-lib')
  optdepends=('headshell: desktop application')

  cd "$_srcdir"
  install -Dm755 "target/release/headshell" "$pkgdir/usr/bin/headshell"

  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
