{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "headshell",
  "identifier": "dev.headshell.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "title": "headshell",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-src https://www.youtube-nocookie.com; media-src http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "A provider-independent music listening layer",
    "longDescription": "Listening history, statistics and playlists belong to the user, not to the provider. Wherever the audio comes from (local files, Subsonic, Jellyfin, plugins), the layer on top stays the same.",
    "copyright": "MIT OR Apache-2.0",
    "licenseFile": "../../LICENSE-MIT",
    "windows": {
      "wix": {
        "version": "0.0.5"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2"
        ],
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ],
        "files": {
          "/usr/share/doc/headshell/copyright": "../../packaging/copyright",
          "/usr/share/doc/headshell/LICENSE-MIT": "../../LICENSE-MIT",
          "/usr/share/doc/headshell/LICENSE-APACHE": "../../LICENSE-APACHE"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "alsa-lib"
        ],
        "recommends": [
          "gstreamer1-plugins-good"
        ],
        "files": {
          "/usr/share/doc/headshell/copyright": "../../packaging/copyright",
          "/usr/share/doc/headshell/LICENSE-MIT": "../../LICENSE-MIT",
          "/usr/share/doc/headshell/LICENSE-APACHE": "../../LICENSE-APACHE"
        }
      }
    }
  }
}
